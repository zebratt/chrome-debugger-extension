{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chrome Connector JSON-RPC 1.0",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/hello" }
  ],
  "$defs": {
    "id": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer" }
      ]
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": {
          "enum": [
            "system.ping", "system.policy", "system.capabilities", "system.shutdown", "browser.list", "extension.reload",
            "tab.list", "tab.open", "tab.info", "tab.navigate", "tab.snapshot",
            "tab.screenshot", "tab.claim", "tab.renew", "tab.release",
            "tab.click", "tab.type", "tab.key", "tab.scroll", "tab.wait", "cdp.send"
          ]
        },
        "params": { "type": "object" }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": ["jsonrpc", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "result": {},
        "error": { "$ref": "#/$defs/error" }
      },
      "oneOf": [
        { "required": ["result"] },
        { "required": ["error"] }
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "data"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {
          "type": "object",
          "required": ["kind", "retryable"],
          "properties": {
            "kind": { "type": "string" },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "hello": {
      "type": "object",
      "required": ["kind", "profileId", "protocolVersion"],
      "properties": {
        "kind": { "const": "hello" },
        "profileId": { "type": "string", "minLength": 1 },
        "connectionId": { "type": "string" },
        "protocolVersion": { "type": "string" },
        "extensionVersion": { "type": "string" },
        "hostVersion": { "type": "string" },
        "browserVersion": { "type": "string" },
        "supportedCdpDomains": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
