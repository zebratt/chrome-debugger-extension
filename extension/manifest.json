{
  "manifest_version": 3,
  "name": "Chrome Connector",
  "version": "0.4.0",
  "description": "Connect local agents to the current Chrome profile.",
  "permissions": ["nativeMessaging", "tabs", "debugger", "storage", "alarms"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Chrome Connector"},
  "options_page": "status.html"
}
